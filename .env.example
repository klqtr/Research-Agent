# 默认不调用任何模型。只有明确授权且配置后才启用。
RESEARCHTRACE_MODEL_ENABLED=false
RESEARCHTRACE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
RESEARCHTRACE_MODEL_NAME=
RESEARCHTRACE_MODEL_API_KEY=
RESEARCHTRACE_MODEL_TIMEOUT=45
# 所有客户端/工作进程共享data_dir/model_budget.sqlite3累计账本；不会自动重置。
RESEARCHTRACE_MODEL_MAX_CALLS=8
RESEARCHTRACE_MODEL_MAX_CONTEXT_CHARS=48000
RESEARCHTRACE_MODEL_MAX_OUTPUT_TOKENS=1600
RESEARCHTRACE_MODEL_MAX_RESERVED_TOKENS=100000
# 0表示未设置美元硬限额，调用/Token上限仍生效；未知费用保持null。
# 设置大于0的美元限额时，必须填写经用户确认的输入/输出单价，不能猜测。
RESEARCHTRACE_MODEL_MAX_COST_USD=0
RESEARCHTRACE_MODEL_INPUT_USD_PER_MILLION=
RESEARCHTRACE_MODEL_OUTPUT_USD_PER_MILLION=
RESEARCHTRACE_DATA_DIR=data/library
RESEARCHTRACE_MAX_UPLOAD_MB=32
# OCR 可选，使用PyMuPDF内置OCR引擎，需另获取语言数据；中文数据尚未配置。
RESEARCHTRACE_OCR_LANGUAGE=eng
RESEARCHTRACE_TESSDATA_DIR=data/tessdata
